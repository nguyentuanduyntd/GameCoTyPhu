; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tỷ Phú Đất Việt"
config/description="Game cờ tỷ phú 3D với 34 tỉnh thành Việt Nam."
run/main_scene="res://scenes/lobby.tscn"
config/version="0.5.0"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.29, 0.16, 0.09, 1)
boot_splash/image="res://assets/icons/splash.png"
boot_splash/fullsize=false

[autoload]

Audio="*res://scripts/audio.gd"
Global="*res://scripts/global.gd"
Net="*res://scripts/net/net_client.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
